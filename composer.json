{
    "name": "spine/laravel-spine",
    "description": "The modular core for building business applications. API-first, modular via nwidart/laravel-modules, Sanctum + Scribe + API versioning.",
    "keywords": ["laravel", "api", "modular", "core", "modules", "headless"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "nwidart/laravel-modules": "^12.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^6.0",
        "spatie/laravel-tags": "^4.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "endroid/qr-code": "^5.0",
        "maatwebsite/excel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Spine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spine\\SpineServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
